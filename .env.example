# ============================================
# INSTRUCTIONS (see SECURITY.md):
# 1. Copy this file to .env (it is already in .gitignore): cp .env.example .env
# 2. Write your credentials in .env; never in this file or in the code.
# 3. Never paste credentials into a prompt to Bob or any other AI assistant.
# On Render these variables are set in the dashboard (Environment), not in files.
# ============================================

# --- Credentials ---------------------------------------------------------------------------
# IBM Bob API key (Inference scope). Required for live audits, Ask Bob and the Studio.
# Only in .env or in the Render dashboard.
BOB_API_KEY=
# The public release intentionally has no LIVE_AUDIT_TOKEN: BOB_API_KEY is the only credential required.
# Optional emergency kill switch: uncomment the line below and set a long random value to require the
# X-Live-Token header for Bob calls and uploaded repositories. The imported showcase always stays open.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# LIVE_AUDIT_TOKEN=

# Inherited from the official hackathon template; CodeArchaeologist does not use it.
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

# --- Bob caps per audit (optional; defaults in parentheses) --------------------------------
# BOB_BINARY=bob
# BOB_TIMEOUT_S=600          # (600) seconds before the session is cut
# BOB_MAX_TURNS=30           # (30) orchestrator turns
# BOB_MAX_COST=5             # (5) bobcoins per audit, closing turn included
# BOB_ACCEPT_LICENSE=false   # true only where the team already accepted the IBM Bob license (container)
# Fixed in code: migration-architect 1 bobcoin / 6 turns; chat (ask) 0.8 bobcoins / 12 turns.
# BOB_DAILY_SPEND_LIMIT=15   # (off) bobcoins the server may spend per UTC day; then live features pause.
#                            # Recommended for a public URL in open mode. Resets when the process restarts.

# --- Modernization Studio caps (optional) --------------------------------------------------
# MODERNIZE_PLAN_MAX_COST=1.5    # (1.5) bobcoins per assessment or per plan
# MODERNIZE_STEP_MAX_COST=3      # (3) bobcoins per implemented step
# MODERNIZE_TOTAL_MAX_COST=6     # (6) bobcoins per full implementation
# MODERNIZE_MAX_STEPS=8          # (8) steps per implementation; the rest are skipped

# --- Other (optional) ----------------------------------------------------------------------
# ALLOW_NON_LIVE_MODES=false     # true only in development: enables the example mode
# ENABLE_DEV_CORS=true           # false in production (the Dockerfile already sets it)
# ARTIFACTS_DIR=artifacts        # where dossiers, memos and diffs are stored
# DATABASE_PATH=                 # jobs SQLite database (default backend/jobs.db)
