# ============================================
# INSTRUCTIONS (see SECURITY.md):
# 1. Copy this file to .env (already in .gitignore): cp .env.example .env
# 2. Fill in your own credentials in .env — never in this file, never in code.
# 3. Never paste credentials into a prompt to Bob or any other AI assistant.
# ============================================

BOB_API_KEY=
# IBM Cloud API Key — get one from https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT
EXECUTION_MODE=live
MAX_ZIP_MB=5

# Bob Shell (opcionales; valores por defecto en backend/app/adapters/bob_adapter.py)
# BOB_BINARY=bob
# BOB_TIMEOUT_S=600
# BOB_MAX_TURNS=30
# BOB_MAX_COST=5
# BOB_ACCEPT_LICENSE=false   # true solo en contenedores donde el equipo ya aceptó la licencia de IBM Bob
