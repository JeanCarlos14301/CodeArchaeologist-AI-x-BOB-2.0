# ============================================
# INSTRUCCIONES (ver SECURITY.md):
# 1. Copia este archivo a .env (ya está en .gitignore): cp .env.example .env
# 2. Escribe tus credenciales en .env; nunca en este archivo ni en el código.
# 3. Nunca pegues credenciales en un prompt a Bob ni a otro asistente de IA.
# En Render estas variables se cargan en el dashboard (Environment), no en archivos.
# ============================================

# --- Credenciales (obligatorias para auditorías live) -------------------------------------
# API key de IBM Bob (scope Inference). Solo en .env o en el dashboard de Render.
BOB_API_KEY=
# Token que exige cualquier operación que invoca a Bob (auditoría live, subir ZIP, preguntar,
# Estudio). Sin él, el servidor rechaza esas operaciones (503). La vitrina importada no lo pide.
# Genera uno largo y aleatorio, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVE_AUDIT_TOKEN=

# Heredada de la plantilla oficial del hackatón; CodeArchaeologist no la usa.
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

# --- Topes de Bob por auditoría (opcionales; valores por defecto entre paréntesis) --------
# BOB_BINARY=bob
# BOB_TIMEOUT_S=600          # (600) segundos antes de cortar la sesión
# BOB_MAX_TURNS=30           # (30) turnos del orquestador
# BOB_MAX_COST=5             # (5) bobcoins por auditoría, incluido el turno de cierre
# BOB_ACCEPT_LICENSE=false   # true solo donde el equipo ya aceptó la licencia de IBM Bob (contenedor)
# Fijos en código: migration-architect 1 bobcoin / 6 turnos; chat (ask) 0,8 bobcoins / 12 turnos.

# --- Topes del Estudio de modernización (opcionales) --------------------------------------
# MODERNIZE_PLAN_MAX_COST=1.5    # (1.5) bobcoins por evaluación o por plan
# MODERNIZE_STEP_MAX_COST=3      # (3) bobcoins por paso implementado
# MODERNIZE_TOTAL_MAX_COST=6     # (6) bobcoins por implementación completa
# MODERNIZE_MAX_STEPS=8          # (8) pasos por implementación; los demás quedan omitidos

# --- Otras (opcionales) --------------------------------------------------------------------
# ALLOW_NON_LIVE_MODES=false     # true solo en desarrollo: habilita el modo example sin token
# ENABLE_DEV_CORS=true           # false en producción (el Dockerfile ya lo fija)
# ARTIFACTS_DIR=artifacts        # dónde se guardan expedientes, memos y diffs
# DATABASE_PATH=                 # SQLite de trabajos (por defecto backend/jobs.db)
