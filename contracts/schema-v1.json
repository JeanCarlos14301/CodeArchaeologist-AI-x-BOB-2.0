{
  "$defs": {
    "ArchitectureOption": {
      "description": "Compared modernization architecture option.",
      "properties": {
        "id": {
          "description": "Option identifier (e.g. OPT-1, OPT-2)",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Name of the alternative",
          "title": "Name",
          "type": "string"
        },
        "pattern": {
          "description": "Modernization pattern (e.g. Strangler Fig, Leaf Cut, Big Bang)",
          "title": "Pattern",
          "type": "string"
        },
        "pros": {
          "description": "Key advantages",
          "items": {
            "type": "string"
          },
          "title": "Pros",
          "type": "array"
        },
        "cons": {
          "description": "Disadvantages and risks",
          "items": {
            "type": "string"
          },
          "title": "Cons",
          "type": "array"
        },
        "target_stack": {
          "description": "Target technology stack (e.g. FastAPI + SQLite/PostgreSQL)",
          "title": "Target Stack",
          "type": "string"
        },
        "risk_level": {
          "description": "Operational risk level",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "estimated_effort_days": {
          "description": "Estimated effort in working days",
          "minimum": 0.0,
          "title": "Estimated Effort Days",
          "type": "number"
        },
        "recommended": {
          "default": false,
          "description": "True if it is the recommended option",
          "title": "Recommended",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "pattern",
        "target_stack",
        "risk_level",
        "estimated_effort_days"
      ],
      "title": "ArchitectureOption",
      "type": "object"
    },
    "CharacterizationTestCase": {
      "description": "Individual result of a characterization test.",
      "properties": {
        "name": {
          "description": "Test name (e.g. test_invoice_owner_access)",
          "title": "Name",
          "type": "string"
        },
        "target_endpoint": {
          "description": "Endpoint under test (e.g. GET /invoices/{id})",
          "title": "Target Endpoint",
          "type": "string"
        },
        "test_type": {
          "description": "Test type (contract, security, business_rule)",
          "title": "Test Type",
          "type": "string"
        },
        "status": {
          "description": "Test verdict",
          "enum": [
            "PASS",
            "FAIL",
            "SKIPPED"
          ],
          "title": "Status",
          "type": "string"
        },
        "duration_ms": {
          "default": 0.0,
          "description": "Duration in milliseconds",
          "minimum": 0.0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Error message if it failed",
          "title": "Error Message"
        }
      },
      "required": [
        "name",
        "target_endpoint",
        "test_type",
        "status"
      ],
      "title": "CharacterizationTestCase",
      "type": "object"
    },
    "CharacterizationTestReport": {
      "description": "Report of the characterization test suite run in the sandbox.",
      "properties": {
        "total_tests": {
          "minimum": 0,
          "title": "Total Tests",
          "type": "integer"
        },
        "passed_count": {
          "minimum": 0,
          "title": "Passed Count",
          "type": "integer"
        },
        "failed_count": {
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "target_endpoint": {
          "title": "Target Endpoint",
          "type": "string"
        },
        "test_cases": {
          "items": {
            "$ref": "#/$defs/CharacterizationTestCase"
          },
          "title": "Test Cases",
          "type": "array"
        },
        "all_passed": {
          "title": "All Passed",
          "type": "boolean"
        }
      },
      "required": [
        "total_tests",
        "passed_count",
        "failed_count",
        "target_endpoint",
        "all_passed"
      ],
      "title": "CharacterizationTestReport",
      "type": "object"
    },
    "EvidenceLocation": {
      "description": "Verifiable physical location of evidence in the source code.",
      "properties": {
        "path": {
          "description": "Normalized relative path of the file in the repository",
          "title": "Path",
          "type": "string"
        },
        "line_start": {
          "description": "Start line (1-indexed)",
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "description": "End line (1-indexed)",
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "fragment": {
          "description": "Exact text fragment of the code in the range",
          "title": "Fragment",
          "type": "string"
        },
        "observed_or_inferred": {
          "default": "observed",
          "description": "Whether the evidence was observed directly in the code or inferred",
          "enum": [
            "observed",
            "inferred"
          ],
          "title": "Observed Or Inferred",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line_start",
        "line_end",
        "fragment"
      ],
      "title": "EvidenceLocation",
      "type": "object"
    },
    "Finding": {
      "description": "Technical or business finding backed by physical evidence.",
      "properties": {
        "id": {
          "description": "Unique finding identifier (e.g. EF-1, F-01)",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "Descriptive title of the finding",
          "title": "Title",
          "type": "string"
        },
        "category": {
          "description": "Taxonomic category (e.g. security/sql-injection, maintainability/large-function, business-rule/duplication)",
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "description": "Technical severity level",
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "description": "Analytical certainty level",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "priority": {
          "description": "Attention priority by value/risk",
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Priority",
          "type": "string"
        },
        "expected_detection": {
          "default": true,
          "description": "True for real findings; False for negative test controls",
          "title": "Expected Detection",
          "type": "boolean"
        },
        "evidence": {
          "description": "List of physical citations in the source code",
          "items": {
            "$ref": "#/$defs/EvidenceLocation"
          },
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "description": "Technical explanation of the detected problem",
          "title": "Explanation",
          "type": "string"
        },
        "verification_method": {
          "description": "Deterministic method to reproduce and verify the finding",
          "title": "Verification Method",
          "type": "string"
        },
        "blast_radius_score": {
          "default": 0.0,
          "description": "Systemic blast radius score computed on the graph (0 to 100)",
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Blast Radius Score",
          "type": "number"
        },
        "transitive_impacted_symbols": {
          "description": "Symbols and functions affected transitively in cascade",
          "items": {
            "type": "string"
          },
          "title": "Transitive Impacted Symbols",
          "type": "array"
        },
        "status": {
          "default": "accepted",
          "description": "Status assigned by the deterministic evidence validator",
          "enum": [
            "accepted",
            "rejected",
            "inferred"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "severity",
        "confidence",
        "priority",
        "explanation",
        "verification_method"
      ],
      "title": "Finding",
      "type": "object"
    },
    "MigrationPhase": {
      "description": "Migration plan phase with a PERT statistical estimate.",
      "properties": {
        "phase_number": {
          "description": "Sequential phase number",
          "minimum": 1,
          "title": "Phase Number",
          "type": "integer"
        },
        "name": {
          "description": "Phase name",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "description": "Scope and deliverables of the phase",
          "title": "Description",
          "type": "string"
        },
        "optimistic_days": {
          "description": "Optimistic scenario (O)",
          "minimum": 0.0,
          "title": "Optimistic Days",
          "type": "number"
        },
        "nominal_days": {
          "description": "Most likely scenario (M)",
          "minimum": 0.0,
          "title": "Nominal Days",
          "type": "number"
        },
        "pessimistic_days": {
          "description": "Pessimistic scenario (P)",
          "minimum": 0.0,
          "title": "Pessimistic Days",
          "type": "number"
        },
        "pert_expected_days": {
          "description": "PERT expected duration: (O + 4M + P) / 6",
          "minimum": 0.0,
          "title": "Pert Expected Days",
          "type": "number"
        },
        "pert_variance": {
          "description": "PERT variance: ((P - O) / 6)^2",
          "minimum": 0.0,
          "title": "Pert Variance",
          "type": "number"
        },
        "assumptions": {
          "description": "Explicit non-negotiable assumptions",
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "prerequisites": {
          "description": "Required technical prerequisites",
          "items": {
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "rollback_strategy": {
          "description": "Rollback strategy in case of contingency",
          "title": "Rollback Strategy",
          "type": "string"
        }
      },
      "required": [
        "phase_number",
        "name",
        "description",
        "optimistic_days",
        "nominal_days",
        "pessimistic_days",
        "pert_expected_days",
        "pert_variance",
        "rollback_strategy"
      ],
      "title": "MigrationPhase",
      "type": "object"
    },
    "MigrationSummary": {
      "description": "Summary of the first migration cut executed with Strangler Fig.",
      "properties": {
        "endpoint_migrated": {
          "description": "Extracted endpoint (e.g. GET /invoices/{id})",
          "title": "Endpoint Migrated",
          "type": "string"
        },
        "modern_code_files": {
          "description": "Modern code files created in modern/",
          "items": {
            "type": "string"
          },
          "title": "Modern Code Files",
          "type": "array"
        },
        "facade_router_file": {
          "description": "Strangler Fig facade router file",
          "title": "Facade Router File",
          "type": "string"
        },
        "legacy_tests_verdict": {
          "description": "Verdict of the characterization tests against the legacy code",
          "enum": [
            "PASS",
            "FAIL",
            "SKIPPED"
          ],
          "title": "Legacy Tests Verdict",
          "type": "string"
        },
        "modern_tests_verdict": {
          "description": "Verdict of the characterization tests against the modernized code",
          "enum": [
            "PASS",
            "FAIL",
            "SKIPPED"
          ],
          "title": "Modern Tests Verdict",
          "type": "string"
        },
        "repaired_count": {
          "default": 0,
          "description": "Number of automatic repairs applied (max 1)",
          "minimum": 0,
          "title": "Repaired Count",
          "type": "integer"
        },
        "diff_patch": {
          "description": "Generated unified .diff patch",
          "title": "Diff Patch",
          "type": "string"
        }
      },
      "required": [
        "endpoint_migrated",
        "modern_code_files",
        "facade_router_file",
        "legacy_tests_verdict",
        "modern_tests_verdict",
        "diff_patch"
      ],
      "title": "MigrationSummary",
      "type": "object"
    },
    "SnapshotMetadata": {
      "description": "Metadata of the analyzed repository.",
      "properties": {
        "sample_id": {
          "description": "Sample identifier (e.g. facturaya-v1)",
          "title": "Sample Id",
          "type": "string"
        },
        "repo_name": {
          "description": "Repository name",
          "title": "Repo Name",
          "type": "string"
        },
        "snapshot_sha256": {
          "description": "SHA-256 hash of the repository content",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "total_files": {
          "minimum": 0,
          "title": "Total Files",
          "type": "integer"
        },
        "total_loc": {
          "minimum": 0,
          "title": "Total Loc",
          "type": "integer"
        },
        "languages_detected": {
          "items": {
            "type": "string"
          },
          "title": "Languages Detected",
          "type": "array"
        },
        "entrypoints": {
          "items": {
            "type": "string"
          },
          "title": "Entrypoints",
          "type": "array"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "execution_mode": {
          "default": "live",
          "description": "Execution mode of the diagnosis (rule D8)",
          "enum": [
            "live",
            "imported",
            "example"
          ],
          "title": "Execution Mode",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "repo_name",
        "snapshot_sha256",
        "total_files",
        "total_loc"
      ],
      "title": "SnapshotMetadata",
      "type": "object"
    },
    "ValidationReport": {
      "description": "Report of the deterministic evidence validator.",
      "properties": {
        "total_references": {
          "minimum": 0,
          "title": "Total References",
          "type": "integer"
        },
        "valid_references": {
          "minimum": 0,
          "title": "Valid References",
          "type": "integer"
        },
        "invalid_references": {
          "minimum": 0,
          "title": "Invalid References",
          "type": "integer"
        },
        "fidelity_ratio": {
          "description": "Share of verified references (1.0 = 100%)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fidelity Ratio",
          "type": "number"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "total_references",
        "valid_references",
        "invalid_references",
        "fidelity_ratio"
      ],
      "title": "ValidationReport",
      "type": "object"
    }
  },
  "description": "Complete technical diagnosis and migration dossier (contract v1).",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Data contract version",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "description": "Unique identifier of the analysis job",
      "title": "Job Id",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotMetadata"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "architecture_options": {
      "items": {
        "$ref": "#/$defs/ArchitectureOption"
      },
      "title": "Architecture Options",
      "type": "array"
    },
    "selected_first_cut": {
      "default": "GET /invoices/{id}",
      "title": "Selected First Cut",
      "type": "string"
    },
    "pert_plan": {
      "items": {
        "$ref": "#/$defs/MigrationPhase"
      },
      "title": "Pert Plan",
      "type": "array"
    },
    "characterization_tests_legacy": {
      "anyOf": [
        {
          "$ref": "#/$defs/CharacterizationTestReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "characterization_tests_modern": {
      "anyOf": [
        {
          "$ref": "#/$defs/CharacterizationTestReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "migration_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/MigrationSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation_report": {
      "$ref": "#/$defs/ValidationReport"
    },
    "executive_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executive Summary"
    },
    "mermaid_er_diagram": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mermaid Er Diagram"
    },
    "mermaid_call_flow": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mermaid Call Flow"
    },
    "execution_mode": {
      "default": "live",
      "enum": [
        "live",
        "imported",
        "example"
      ],
      "title": "Execution Mode",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "snapshot",
    "validation_report"
  ],
  "title": "DossierResult",
  "type": "object"
}